---
const { title, color = "black" } = Astro.props;
import "../styles/reset.scss";
import "../styles/global.scss";
import "../styles/_variables.scss";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Stefaniia Bodnia is a designer based in The Hague, Netherlands."
    />
    <link href="https://stefaniiabodnia.xyz/" rel="canonical" />
    <meta content="en_US" property="og:locale" />
    <meta content="all" name="robots" />
    <meta content="Stefaniia Bodnia" property="og:title" />
    <meta
      content="Stefaniia Bodnia is a designer based in The Hague, Netherlands."
      property="og:description"
    />
    <meta content="Stefaniia Bodnia" property="og:site_name" />
    <title>{title}</title>
    <!-- iOS Safari inflates the text of wide blocks on its own — full-width
         project captions and descriptions came out bigger than the nav and
         table cells. Inline so the build can't strip the -webkit- prefix,
         which is the only one Safari reads -->
    <style is:inline>
      html {
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }
    </style>
  </head>
  <body style={`color: ${color}`}>
    <!-- shared header / nav goes here -->
    <slot />
    <!-- shared footer goes here -->
  </body>
</html>
